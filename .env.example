# Loaded by `make dev` through uv. Local development only.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Local single-user library. The project-managed database uses port 55432.
PAPERTRAIL_DATABASE_URL=postgresql://papertrail@127.0.0.1:55432/papertrail
PAPERTRAIL_DATA_DIR=data/library
PAPERTRAIL_MAX_UPLOAD_BYTES=20971520
PAPERTRAIL_MAX_PAGES=100
PAPERTRAIL_PARSE_TIMEOUT=20

# v0.1 model: configure only in ignored .env.local, never paste keys into source or chat.
# OpenAI-compatible Chat Completions endpoint, e.g. https://api.deepseek.com
PAPERTRAIL_MODEL_BASE_URL=
# Optional exact HTTP origin for an explicitly selected relay; not a base URL/path or a list.
# Example: http://192.168.1.2:8080 (HTTPS and localhost HTTP do not need this setting).
PAPERTRAIL_MODEL_ALLOW_HTTP_ORIGIN=
PAPERTRAIL_MODEL_NAME=
PAPERTRAIL_MODEL_API_KEY=
# Explicit payload profile: compatible (default) or openai; never inferred from the model name.
PAPERTRAIL_MODEL_PROFILE=compatible
PAPERTRAIL_MODEL_TIMEOUT=45
PAPERTRAIL_MODEL_MAX_OUTPUT_TOKENS=1800
# Compatible profile only. Leave empty for the openai profile.
PAPERTRAIL_MODEL_THINKING=

# Default priced mode requires an authorized amount and verified rates in the SAME currency.
# Explicit provider_quota mode authorizes using existing provider credit without invented rates.
# It requires explicit MAX_CALLS: 1-1000, or the exact value unlimited when authorized.
# unlimited removes only the cumulative count cap; per-task bounds and the ledger remain.
# All prior calls stay in this scope, including priced calls; restoring a number counts them all.
PAPERTRAIL_MODEL_BUDGET_MODE=priced
PAPERTRAIL_MODEL_MAX_CALLS=
PAPERTRAIL_MODEL_BUDGET=
PAPERTRAIL_MODEL_CURRENCY=
PAPERTRAIL_MODEL_INPUT_PRICE_PER_MILLION=
PAPERTRAIL_MODEL_OUTPUT_PRICE_PER_MILLION=
PAPERTRAIL_MODEL_BUDGET_SCOPE=v01-development

# Optional introduction-only reasoning; ordinary QA stays none. low requires openai profile.
PAPERTRAIL_INTRODUCTION_REASONING_EFFORT=none
